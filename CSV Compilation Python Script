You don’t need anything fancy here—just a deterministic parser that treats blank lines or repeated NAME= as record boundaries and explodes multi-valued fields (papers, interests) into rows.

Below is a clean, production-style Python script (pandas-based) that outputs three normalized CSVs:

profiles.csv (one row per person)
papers.csv (one row per paper)
interests.csv (one row per interest)
Python code
import pandas as pd

def parse_txt_to_csv(input_file):
    profiles = []
    papers = []
    interests = []

    current = {
        "name": "",
        "affiliation": "",
        "departments": "",
        "email": "",
        "website": "",
        "interests": [],
        "papers": []
    }

    def save_current():
        if current["name"] == "":
            return
        
        profiles.append({
            "name": current["name"],
            "affiliation": current["affiliation"],
            "departments": current["departments"],
            "email": current["email"],
            "website": current["website"]
        })

        for interest in current["interests"]:
            interests.append({
                "name": current["name"],
                "interest": interest.strip()
            })

        for p in current["papers"]:
            parts = p.split("|")
            title = parts[0] if len(parts) > 0 else ""
            year = parts[1] if len(parts) > 1 else ""
            venue = parts[2] if len(parts) > 2 else ""

            papers.append({
                "name": current["name"],
                "title": title,
                "year": year,
                "venue": venue
            })

    with open(input_file, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()

            if not line:
                continue

            if line.startswith("NAME="):
                # save previous record
                save_current()

                # reset
                current = {
                    "name": line.replace("NAME=", "").strip(),
                    "affiliation": "",
                    "departments": "",
                    "email": "",
                    "website": "",
                    "interests": [],
                    "papers": []
                }

            elif line.startswith("AFFILIATION="):
                current["affiliation"] = line.replace("AFFILIATION=", "").strip()

            elif line.startswith("DEPARTMENTS="):
                current["departments"] = line.replace("DEPARTMENTS=", "").strip()

            elif line.startswith("EMAIL="):
                current["email"] = line.replace("EMAIL=", "").strip()

            elif line.startswith("WEBSITE="):
                current["website"] = line.replace("WEBSITE=", "").strip()

            elif line.startswith("INTERESTS="):
                vals = line.replace("INTERESTS=", "").split(";")
                current["interests"] = vals

            elif line.startswith("PAPER="):
                current["papers"].append(line.replace("PAPER=", "").strip())

        # save last record
        save_current()

    # convert to DataFrames
    df_profiles = pd.DataFrame(profiles)
    df_papers = pd.DataFrame(papers)
    df_interests = pd.DataFrame(interests)

    # write CSVs
    df_profiles.to_csv("profiles.csv", index=False)
    df_papers.to_csv("papers.csv", index=False)
    df_interests.to_csv("interests.csv", index=False)

    print("Done: profiles.csv, papers.csv, interests.csv created.")


# usage
parse_txt_to_csv("input.txt")
